  keywords = {Stochastic PDEs, Low-Rank Approximation, Uncertainty Quantification}
}

@inproceedings{liu2023icml_poster,
  title = {Spectral Bias Mitigation in Physics-Informed Neural Operators via Multi-Scale Fourier Embeddings},
  author = {Jiale Liu and Jane Doe and Richard Feynman},
  booktitle = {ICML Workshop on Differentiable Almost Everything},
  year = {2023},
  month = jul,
  address = {Honolulu, HI, USA},
  presentation = {poster},
  abstract = {Physics-informed neural operators often struggle to resolve high-frequency boundary layers due to spectral bias. By conditioning Fourier feature embeddings on local Péclet and Reynolds numbers, our method captures sharp multi-scale gradients without sacrificing generalization across geometries.},
  description = {Poster session examining multi-scale Fourier feature conditioning to overcome spectral bias in neural operators.},
  keywords = {Neural Operators, Physics-Informed ML, Fourier Features}
}
