@inproceedings{liu2025aps_symplectic,
  title = {Symplectic Tensor Propagators for Non-Equilibrium Quantum Spin Chains},
  author = {Jiale Liu and Ada Lovelace*},
  booktitle = {APS Global Physics Summit 2025},
  year = {2025},
  month = mar,
  address = {Anaheim, CA, USA},
  presentation = {oral},
  award = {Best Student Oral Presentation Award},
  pdf = {sample-paper.pdf},
  abstract = {We present a structure-preserving symplectic tensor-network integrator for simulating long-time quench dynamics in one-dimensional quantum spin chains.

Our approach enforces local energy and norm conservation up to controllable truncation tolerances, achieving a 3x reduction in bond dimension growth compared to standard fourth-order Trotter decompositions.},
  description = {Invited contributed talk introducing structure-preserving symplectic tensor propagators for non-equilibrium quantum spin dynamics.},
  keywords = {Quantum Dynamics, Tensor Networks, Symplectic Integrators}
}

@inproceedings{liu2024neurips_workshop,
  title = {Uncertainty-Aware Neural ODE Surrogates for Stiff Chemical Kinetics},
  author = {Jiale Liu# and Sarah O'Connor#* and Alan Turing},
  booktitle = {NeurIPS Workshop on AI for Science},
  year = {2024},
  month = dec,
  address = {Vancouver, Canada},
  presentation = {poster},
  award = {Outstanding Poster Honorable Mention},
  abstract = {Stiff ordinary differential equation systems pose significant stability challenges for learned surrogate models. We introduce an uncertainty-calibrated implicit neural ODE architecture trained with adjoint sensitivity regularization, yielding reliable error bounds across multi-scale combustion and atmospheric chemistry benchmarks.},
  description = {Poster presentation demonstrating calibrated implicit neural ODE surrogates for stiff chemical reaction networks.},
  keywords = {Neural ODEs, Uncertainty Quantification, Scientific ML}
}

@inproceedings{brown2024siam_uq,
  title = {Adaptive Low-Rank Approximation of Parametric Stochastic PDEs on Curved Manifolds},
  author = {Charlie Brown and Jiale Liu*},
  booktitle = {SIAM Conference on Uncertainty Quantification (UQ24)},
  year = {2024},
  month = feb,
  address = {Trieste, Italy},
  presentation = {oral},
  abstract = {We develop an adaptive dynamical low-rank approximation scheme for parametric stochastic partial differential equations discretized on Riemannian manifolds. Theoretical stability estimates and numerical experiments on spherical shallow-water flows confirm spectral convergence with minimal basis rank.},
